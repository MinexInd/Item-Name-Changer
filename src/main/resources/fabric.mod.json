{
	"schemaVersion": 1,
	"id": "item-name-changer",
	"version": "${version}",
	"name": "Item Name Changer",
	"description": "A lightweight client-sided mod that lets players rename items through simple commands.",
	"authors": [
		"MinexInd!"
	],
	"license": "MIT",
	"icon": "assets/item-name-changer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.minex.itemnamechanger.ItemNameChanger"
		],
		"client": [
			"net.minex.itemnamechanger.ItemNameChangerClient"
		]
	},
	"mixins": [
		"item-name-changer.mixins.json",
		{
			"config": "item-name-changer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
